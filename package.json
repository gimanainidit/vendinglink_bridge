{
  "name": "vendinglink_bridge",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "test": "vitest run",
    "lint": "eslint . --ext .ts",
    "db:gen": "tsx scripts/gen-schema.ts",
    "db:push": "prisma db push --schema=prisma/sqlite/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema=prisma/postgres/schema.prisma"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gimanainidit/vendinglink_bridge.git"
  },
