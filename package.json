  },
  "homepage": "https://github.com/gimanainidit/vendinglink_bridge#readme",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "axios": "^1.20.0",
    "bullmq": "^6.3.11",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "ioredis": "^6.0.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "telegraf": "^4.16.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "nock": "^14.0.17",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.9",
    "prisma": "^6.19.3",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
