NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=https://your-ngrok-url.ngrok.app

# Telegram
BOT_TOKEN=1234567890:ABCDEFGHIJKLMNOPQRSTUVWXYZ
TELEGRAM_WEBHOOK_SECRET=your-secret-token-here
ADMIN_TELEGRAM_ID=123456789

# Database
# Local SQLite
DATABASE_PROVIDER=sqlite
DATABASE_URL=file:./dev.db
# Prod Postgres
# DATABASE_PROVIDER=postgres
# DATABASE_URL=postgresql://user:password@localhost:5432/bridge?schema=public

# Redis (for BullMQ)
REDIS_URL=redis://localhost:6379

# VendingLink
VENDINGLINK_URL=https://your-vendinglink-domain.com
BRIDGE_SECRET_KEY=secret-key-shared-with-vendinglink

# Encryption (AES-256-GCM, must be exactly 32 bytes base64 encoded)
# Generate with: node -e "console.log(crypto.randomBytes(32).toString('base64'))"
KEYS_ENCRYPTION_KEY=your-32-byte-base64-string-here

# Limits
MAX_BUY_QTY=100

# Suppliers
# RZK (Rezeki Shop)
SUPPLIER_RZK_BASE_URL=https://api.prastyaaneki.biz.id
SUPPLIER_RZK_API_KEY=sk_live_xxxxxxxxxxxxxxxxxx
