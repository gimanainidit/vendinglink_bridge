NODE_ENV=development
PORT=5000
PUBLIC_BASE_URL=https://your-ngrok-url.ngrok.app

# Telegram
BOT_TOKEN=1234567890:ABCDEFGHIJKLMNOPQRSTUVWXYZ
TELEGRAM_WEBHOOK_SECRET=your-secret-token-here
ADMIN_TELEGRAM_ID=123456789

# Database
# Local SQLite
DATABASE_PROVIDER=sqlite
DATABASE_URL=file:./dev.db
# Prod Postgres
# DATABASE_PROVIDER=postgres
# DATABASE_URL=postgresql://user:password@localhost:5432/bridge?schema=public

# Redis (for BullMQ)
REDIS_URL=redis://localhost:6379

# VendingLink
VENDINGLINK_URL=https://your-vendinglink-domain.com
BRIDGE_SECRET_KEY=secret-key-shared-with-vendinglink

# Encryption (AES-256-GCM, must be exactly 32 bytes base64 encoded)
# Generate with: node -e "console.log(crypto.randomBytes(32).toString('base64'))"
KEYS_ENCRYPTION_KEY=your-32-byte-base64-string-here

# Limits
MAX_BUY_QTY=100

# Suppliers
# RZK (Rezeki Shop)
SUPPLIER_RZK_BASE_URL=https://api.prastyaaneki.biz.id
SUPPLIER_RZK_API_KEY=sk_live_xxxxxxxxxxxxxxxxxx

# PDA (Prime Digital AI)
SUPPLIER_PDA_BASE_URL=https://prime-digital-ai.com
SUPPLIER_PDA_API_KEY=psk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# DAI (Digital AI Store) - Alias SUPLIER_DAI_BASE_URL & DAI_API_KEY supported
SUPPLIER_DAI_BASE_URL=http://43.156.46.152:8000
SUPPLIER_DAI_API_KEY=your_reseller_api_key_here

# Backup & DR (BR-8)
BACKUP_RCLONE_REMOTE=gdrive:backups/bridge
BACKUP_ENCRYPTION_KEY=your-32-byte-base64-string-here

# Agentic Purchasing & Procurement Guardrails (P2a)
AGENT_ENABLED=true
AGENT_MAX_SPEND_PER_REQUEST=500000
AGENT_MAX_SPEND_PER_DAY=5000000
AGENT_MIN_BALANCE_FLOOR=200000
AGENT_PRICE_DELTA_ALERT_PCT=20
AGENT_ALLOWED_SUPPLIER_CODES=RZK,PDA,DAI
AGENT_HIGH_VALUE_THRESHOLD=1000000



# Hermes Agent Runner Integration (P2b / Localhost)
HERMES_API_SECRET=hermes-local-secret-change-in-prod
